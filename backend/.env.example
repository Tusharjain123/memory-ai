PORT=3000
REDIS_URL=redis://127.0.0.1:6379
DEEPGRAM_API_KEY=
# Nova-3 multilingual ASR; override language only when audio is consistently monolingual.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
# Provider timeouts are floors; the pipeline scales them up for longer audio.
DEEPGRAM_TIMEOUT_MS=600000
FFMPEG_TIMEOUT_MS=120000
# Batch Deepgram requests in 5-minute chunks when audio exceeds 5 minutes;
# chunks are sent in parallel (max 8) and only weak chunks get a Hindi retry.
DEEPGRAM_CHUNK_THRESHOLD_SEC=300
DEEPGRAM_CHUNK_SEC=300
DEEPGRAM_CHUNK_CONCURRENCY=4
# Upload and duration limits for up to 3-hour mono recordings.
MAX_AUDIO_DURATION_SEC=10800
MAX_UPLOAD_BYTES=209715200
UPLOAD_PART_BYTES=4194304
# Ollama Cloud generates structured summaries and answers.
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen3.5:397b
OLLAMA_CHAT_TIMEOUT_MS=300000
# Clean/Hinglish transcript text runs in parallel 40-utterance batches (max 8).
OLLAMA_POLISH_CONCURRENCY=4
OLLAMA_DISCOVERY_TIMEOUT_MS=10000
# OpenAI generates matching memory and query embeddings.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMENSIONS=1024
OPENAI_EMBED_TIMEOUT_MS=120000
OPENAI_DISCOVERY_TIMEOUT_MS=10000
PROCESSING_CONCURRENCY=2
# Unique per machine/container because queued jobs reference host-local temp files.
PROCESSING_QUEUE_SCOPE=
# Supabase stores voluntary in-app feedback and a short-lived processing
# result handoff (see supabase/processing_results.sql). Keep the secret key
# backend-only. Run both SQL files in the Supabase SQL editor once.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional Google accounts: access tokens are verified against
# $SUPABASE_URL/auth/v1/.well-known/jwks.json. Set this only if the project
# still signs tokens with the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=
# Optional Google Calendar + Meet import (see README). GOOGLE_CLIENT_ID is the
# Web OAuth client (same as the app's EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID).
# GOOGLE_TOKEN_ENCRYPTION_KEY encrypts stored refresh tokens:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Wallet & billing (amounts in USD; wallet stores micro-USD) ---
# AI work is charged to the signed-in user's wallet. Set to "off" only for local
# builds without Supabase.
WALLET_BILLING=on
# Our provider costs, used to meter each conversation's actual cost.
PRICE_DEEPGRAM_PER_MIN_USD=0.0052
PRICE_LLM_INPUT_PER_MTOK_USD=0.5
PRICE_LLM_OUTPUT_PER_MTOK_USD=2
PRICE_EMBED_PER_MTOK_USD=0.13

# --- Dodo Payments (wallet top-ups) ---
DODO_API_KEY=
# Webhook signing secret from the Dodo dashboard (starts with whsec_).
DODO_WEBHOOK_SECRET=
# test | live
DODO_ENV=test
# Public https URL of this backend (Dodo return URL + webhook):
#   {PUBLIC_API_URL}/v1/payments/dodo/webhook
PUBLIC_API_URL=
# One Dodo one-time product per pack. Credit is always 2/3 of the price.
# WALLET_PACKS=[{"id":"starter","productId":"pdt_xxx","priceCents":600},{"id":"plus","productId":"pdt_yyy","priceCents":1500},{"id":"pro","productId":"pdt_zzz","priceCents":3000}]
WALLET_PACKS=
