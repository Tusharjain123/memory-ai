PORT=3000
REDIS_URL=redis://127.0.0.1:6379
DEEPGRAM_API_KEY=
# Nova-3 multilingual ASR; override language only when audio is consistently monolingual.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
# Provider timeouts are floors; the pipeline scales them up for longer audio.
DEEPGRAM_TIMEOUT_MS=600000
FFMPEG_TIMEOUT_MS=120000
# Batch Deepgram requests in 5-minute chunks when audio exceeds 5 minutes.
DEEPGRAM_CHUNK_THRESHOLD_SEC=300
DEEPGRAM_CHUNK_SEC=300
DEEPGRAM_CHUNK_CONCURRENCY=1
# Upload and duration limits for up to 3-hour mono recordings.
MAX_AUDIO_DURATION_SEC=10800
MAX_UPLOAD_BYTES=209715200
UPLOAD_PART_BYTES=20971520
# Ollama Cloud generates structured summaries and answers.
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen3.5:397b
OLLAMA_CHAT_TIMEOUT_MS=300000
OLLAMA_DISCOVERY_TIMEOUT_MS=10000
# OpenAI generates matching memory and query embeddings.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMENSIONS=1024
OPENAI_EMBED_TIMEOUT_MS=120000
OPENAI_DISCOVERY_TIMEOUT_MS=10000
PROCESSING_CONCURRENCY=2
# Unique per machine/container because queued jobs reference host-local temp files.
PROCESSING_QUEUE_SCOPE=
# Supabase stores voluntary in-app feedback. Keep the secret key backend-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
