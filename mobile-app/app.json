{
  "expo": {
    "name": "Memory AI",
    "slug": "memory-ai",
    "scheme": "memoryai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/memory-ai-logo.png",
    "splash": {
      "image": "./assets/memory-ai-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "ai.memory.mobile",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/memory-ai-logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Memory AI to record conversations."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock your private conversation memory."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aae547b3-db97-4599-bd94-94e79688101d"
      }
    },
    "owner": "tusharjains-team",
    "ios": {
      "bundleIdentifier": "ai.memory.mobile"
    }
  }
}
