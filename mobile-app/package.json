{
  "name": "@memory-ai/mobile-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "build:preview": "pnpx eas-cli build --platform android --profile preview",
    "build:production": "pnpx eas-cli build --platform android --profile production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@expo/vector-icons": "^14.1.0",
    "expo": "~53.0.12",
    "expo-audio": "~0.4.8",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-file-system": "~18.1.10",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-local-authentication": "~16.0.5",
    "expo-router": "~5.1.0",
    "expo-secure-store": "~14.2.3",
    "expo-sharing": "~13.1.5",
    "expo-sqlite": "~15.2.12",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-keyboard-controller": "^1.22.3",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
