# Development only: Android emulator reaches the host through 10.0.2.2.
# Release builds require an explicit HTTPS URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Optional cloud features ("Connect Google"). Leave blank to ship a fully
# on-device build; the app hides cloud options when these are missing.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Cloud OAuth "Web application" client ID (also set in Supabase → Auth → Google).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID; also add its reversed form as iosUrlScheme in app.json.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
